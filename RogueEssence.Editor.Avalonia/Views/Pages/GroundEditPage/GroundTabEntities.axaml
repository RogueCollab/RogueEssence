<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RogueEssence.Dev.ViewModels;assembly=RogueEssence.Editor.Avalonia"
             xmlns:views="clr-namespace:RogueEssence.Dev.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:RogueEssence.Dev"
             xmlns:converters="clr-namespace:RogueEssence.Dev.Converters"
             mc:Ignorable="d"
             x:Class="RogueEssence.Dev.Views.GroundTabEntities">
  <Design.DataContext>
    <vm:GroundTabEntitiesViewModel/>
  </Design.DataContext>
  <UserControl.Resources>
    <converters:ComparisonConverter x:Key="ComparisonConverter"/>
  </UserControl.Resources>
  <Grid Margin="4" RowDefinitions="38, *" ColumnDefinitions="180, *">
    <CheckBox Margin="4" IsChecked="{Binding ShowBoxes}">Show Boxes</CheckBox>
    <!--views:LayerBox DataContext="{Binding Layers}" Grid.Row="1" Grid.Column="0"/-->
    <views:EntityBrowser Margin="4" DataContext="{Binding EntBrowser}" Grid.Row="1" Grid.Column="1"/>
    <Grid Grid.Column="1" RowDefinitions="16,26" ColumnDefinitions="*,*">
      <TextBlock Margin="4,2" VerticalAlignment="Bottom">Mode</TextBlock>
      <RadioButton IsChecked="{Binding Path=EntMode, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static local:EntEditMode.SelectEntity}}" VerticalAlignment="Top" Margin="2" Grid.Row="1">Select/Move</RadioButton>
      <RadioButton IsChecked="{Binding Path=EntMode, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static local:EntEditMode.PlaceEntity}}" VerticalAlignment="Top" Margin="2" Grid.Row="1" Grid.Column="1">Add/Delete</RadioButton>
    </Grid>
  </Grid>
</UserControl>
