<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RogueEssence.Dev.ViewModels;assembly=RogueEssence.Editor.Avalonia"
             xmlns:views="clr-namespace:RogueEssence.Dev.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:RogueEssence.Dev"
             xmlns:converters="clr-namespace:RogueEssence.Dev.Converters"
             mc:Ignorable="d"
             x:Class="RogueEssence.Dev.Views.MapTabTerrain">
    <Design.DataContext>
        <vm:MapTabTerrainViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:ComparisonConverter x:Key="ComparisonConverter" />
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid RowDefinitions="38,38,*" ColumnDefinitions="180,*">
            <CheckBox Margin="4" IsChecked="{Binding ShowTerrain}" Grid.Row="0" Grid.Column="0">Show Terrain</CheckBox>
            <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="16,26" ColumnDefinitions="*,*,*,*">
                <TextBlock Margin="4,2" VerticalAlignment="Bottom">Mode</TextBlock>
                <RadioButton
                    IsChecked="{Binding Path=TerrainMode, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static local:TileEditMode.Draw}}"
                    VerticalAlignment="Top" Margin="2" Grid.Row="1">
                    Draw
                </RadioButton>
                <RadioButton
                    IsChecked="{Binding Path=TerrainMode, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static local:TileEditMode.Rectangle}}"
                    VerticalAlignment="Top" Margin="2" Grid.Row="1" Grid.Column="1">
                    Rectangle
                </RadioButton>
                <RadioButton
                    IsChecked="{Binding Path=TerrainMode, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static local:TileEditMode.Fill}}"
                    VerticalAlignment="Top" Margin="2" Grid.Row="1" Grid.Column="2">
                    Fill
                </RadioButton>
                <RadioButton
                    IsChecked="{Binding Path=TerrainMode, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static local:TileEditMode.Eyedrop}}"
                    VerticalAlignment="Top" Margin="2" Grid.Row="1" Grid.Column="3">
                    Eyedrop
                </RadioButton>
            </Grid>
            <TextBlock Margin="4,2" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="1">Terrain:</TextBlock>
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,120">
                <views:SearchComboBox ItemsSource="{Binding TerrainTypes}" SelectedIndex="{Binding ChosenTerrain}"
                                      VerticalAlignment="Center" Margin="4,2" />
                <CheckBox Margin="4" IsChecked="{Binding StableTex}" Grid.Column="1"
                          ToolTip.Tip="Prevents the texture from being overwritten by the Texture Map.">
                    Stable Texture
                </CheckBox>
            </Grid>
            <TabControl TabStripPlacement="Top" SelectedIndex="{Binding TabIndex}" Margin="4" Grid.Row="2"
                        Grid.ColumnSpan="2">
                <TabItem Header="Tiles">
                    <views:TileBrowser DataContext="{Binding TileBrowser}" />
                </TabItem>
                <TabItem Header="Autotiles">
                    <views:AutotileBrowser DataContext="{Binding AutotileBrowser}" />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>