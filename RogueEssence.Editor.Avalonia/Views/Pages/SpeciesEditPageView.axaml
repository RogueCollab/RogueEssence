<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RogueEssence.Dev.ViewModels"
             xmlns:v="clr-namespace:RogueEssence.Dev.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:SpeciesEditPageViewModel"

             xmlns:converters="clr-namespace:RogueEssence.Dev.Converters"
             x:Class="RogueEssence.Dev.Views.SpeciesEditPageView">
    <Design.DataContext>
        <vm:SpeciesEditPageViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:OXConverter x:Key="OXConverter" />
    </UserControl.Resources>
    <Grid RowDefinitions="Auto, 32, Auto, Auto">
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="Edit" Classes="menuright">
                    
                    <MenuItem Header="Mass Import" Command="{Binding mnuMassImport_Click}" />
                    <MenuItem Header="Re-Index" Command="{Binding mnuReIndex_Click}" />
                    <Separator />
                    <MenuItem Header="Mass Export" Command="{Binding mnuMassExport_Click}" />
                    <MenuItem Header="Mass Export Multi Sheet" Command="{Binding mnuMassExportMulti_Click}" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <Grid Grid.Row="3" RowDefinitions="Auto, Auto, Auto, Auto" Margin="64, 8">

            <TextBlock Grid.Row="0" HorizontalAlignment="Center" Classes="table_header" FontSize="16"
                       Text="{Binding HeaderText}" />

            
            <TextBox Classes="search"
                     Grid.Row="1"
                     Text="{Binding Filter, Mode=TwoWay}"/>

            <TreeDataGrid Margin="0, 16, 0, 8" x:Name="SpeciesEditTreeDataGrid" Background="{DynamicResource Brush.Contents}"
                          SelectionChanging="SpeciesEditTreeDataGrid_OnSelectionChanging" ShowColumnHeaders="False"
                          Grid.Row="2" Source="{Binding NodeSource}" Grid.ColumnSpan="4" Height="400"
                          BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
                <TreeDataGrid.Styles>
                    <Style Selector="TreeDataGridRow">
                        <Setter Property="Background" Value="{DynamicResource Brush.Contents}" />
                    </Style>
                </TreeDataGrid.Styles>
                <TreeDataGrid.Resources>
                    <DataTemplate x:Key="MonsterNodeTemplate" DataType="vm:MonsterNodeViewModel">
                        <Grid ColumnDefinitions="24, *">
                            <Image Source="{Binding Filled, Converter={StaticResource OXConverter}}"
                                   Stretch="None" Grid.Column="0" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Grid.Column="1" />
                        </Grid>
                    </DataTemplate>
                </TreeDataGrid.Resources>
                <TreeDataGrid.ContextMenu>
                    <ContextMenu ItemsSource="{Binding OpList}">
                        <ContextMenu.Styles>
                            <Style Selector="MenuItem">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                            </Style>
                        </ContextMenu.Styles>
                    </ContextMenu>
                </TreeDataGrid.ContextMenu>
            </TreeDataGrid>
            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Button Classes="flat" Width="100"
                        Command="{Binding btnImport_Click}"
                        IsEnabled="{Binding ChosenMonster, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <v:IconText Text="Import" Icon="Icons.DownloadFill" IconSize="12" />
                </Button>
                <Button Classes="flat" Width="100" Margin="24,0,0,0"
                        Command="{Binding btnReImport_Click}"
                        IsEnabled="{Binding CachedPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <v:IconText Text="Re-Import" Icon="Icons.RepeatFill" IconSize="12" />
                </Button>
                <Button Classes="flat" Width="100" Margin="24,0,0,0"
                        Command="{Binding btnExport_Click}"
                        IsEnabled="{Binding ChosenMonster, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <v:IconText Text="Export" Icon="Icons.ExportFill" IconSize="12" />
                </Button>
                <Button Classes="flat" Width="100" Margin="24,0,0,0"
                        Command="{Binding btnDelete_Click}"
                        IsEnabled="{Binding 
                        ChosenMonster, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <v:IconText Text="Delete" Icon="Icons.TrashFill" IconSize="12" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>