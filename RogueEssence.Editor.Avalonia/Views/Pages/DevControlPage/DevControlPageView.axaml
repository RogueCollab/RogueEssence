<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RogueEssence.Dev.ViewModels"
             xmlns:views="clr-namespace:RogueEssence.Dev.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             FontSize="12"
             x:DataType="vm:DevControlPageViewModel"
             x:Class="RogueEssence.Dev.Views.DevControlPageView">
    
    
    <Design.DataContext>
        <vm:DevControlPageViewModel/>
    </Design.DataContext>
    <Border>
        <TabControl>
            <TabItem Header="Game">
                <views:DevTabGame DataContext="{Binding Game}"/>
            </TabItem>
            <TabItem Header="Player">
                <views:DevTabPlayer DataContext="{Binding Player}"/>
            </TabItem>
            <TabItem Header="Travel">
                <views:DevTabTravel DataContext="{Binding Travel}"/>
            </TabItem>
            <TabItem Header="Script">
                <views:DevTabScript DataContext="{Binding Script}"/>
            </TabItem>
        </TabControl>
    </Border>
</UserControl>