<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:RogueEssence.Dev.ViewModels"
                    x:Class="RogueEssence.Dev.Views.MapResizeWindowView"
                    x:DataType="vm:MapResizeWindowViewModel"
                    xmlns:v="using:RogueEssence.Dev.Views"
                    CanResize="False"
                    Title="Resize Map" 
                    Height="380" 
                    Width="260"
                    xmlns:converters="clr-namespace:RogueEssence.Dev.Converters"
                    xmlns:local="clr-namespace:RogueElements;assembly=RogueElements"
                    x:Name="ThisControl">

    <v:ChromelessWindow.Resources>
        <converters:ComparisonXConverter x:Key="ComparisonXConverter"/>
    </v:ChromelessWindow.Resources>
    <Design.DataContext>
        <vm:MapResizeWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, 30">
        <!-- TitleBar -->
        <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
            <Border Background="{DynamicResource Brush.TitleBar}"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
                    PointerPressed="BeginMoveWindow" />

            <Path Width="14" Height="14"
                  Margin="10,0,0,0"
                  HorizontalAlignment="Left"
                  Data="{StaticResource Icons.SoftwareUpdate}"
                  IsVisible="{OnPlatform True, macOS=False}" />

            <TextBlock Classes="bold"
                       x:Name="TitleText"
                       Text="{Binding #ThisControl.Title}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" />

            <v:CaptionButtons HorizontalAlignment="Right"
                              IsCloseButtonOnly="True"
                              IsVisible="{OnPlatform True, macOS=False}" />

        </Grid>
        

        <Grid Grid.Row="1" Margin="4" RowDefinitions="20,42,20,42,20,40,80,40" ColumnDefinitions="*,*,*,*">
            <Grid.Styles>
                <!-- <Grid.Styles> -->
                <Style Selector="Button">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="{DynamicResource Brush.ListBox.Background}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="0" />
                </Style>
                <Style Selector="Button:pointerover">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Style>
                <!-- </Grid.Styles> -->
            </Grid.Styles>
            <TextBlock Margin="4" VerticalAlignment="Bottom" Grid.ColumnSpan="4">Width</TextBlock>
            <NumericUpDown Increment="1" Value="{Binding MapWidth}" Minimum="1" Maximum="1000" Margin="4" Grid.Row="1" Grid.ColumnSpan="4"/>
            <TextBlock Margin="4" VerticalAlignment="Bottom" Grid.Row="2" Grid.ColumnSpan="4">Height</TextBlock>
            <NumericUpDown  Increment="1" Value="{Binding MapHeight}" Minimum="1" Maximum="1000" Margin="4" Grid.Row="3" Grid.ColumnSpan="4"/>
            <TextBlock Margin="4" VerticalAlignment="Bottom" Grid.Row="4" Grid.ColumnSpan="4">Anchor</TextBlock>
            <Button Command="{Binding btnUpLeft_Click}" Content="{Binding Path=ResizeDir, Converter={StaticResource ComparisonXConverter}, ConverterParameter={x:Static local:Dir8.UpLeft}}" Margin="4" Grid.Row="5"/>
            <Button Command="{Binding btnUp_Click}" Content="{Binding Path=ResizeDir, Converter={StaticResource ComparisonXConverter}, ConverterParameter={x:Static local:Dir8.Up}}" Margin="4" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"/>
            <Button Command="{Binding btnUpRight_Click}" Content="{Binding Path=ResizeDir, Converter={StaticResource ComparisonXConverter}, ConverterParameter={x:Static local:Dir8.UpRight}}" Margin="4" Grid.Row="5" Grid.Column="3"/>
            <Button Command="{Binding btnLeft_Click}" Content="{Binding Path=ResizeDir, Converter={StaticResource ComparisonXConverter}, ConverterParameter={x:Static local:Dir8.Left}}" Margin="4" Grid.Row="6"/>
            <Button Command="{Binding btnNone_Click}" Content="{Binding Path=ResizeDir, Converter={StaticResource ComparisonXConverter}, ConverterParameter={x:Static local:Dir8.None}}" Margin="4" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"/>
            <Button Command="{Binding btnRight_Click}" Content="{Binding Path=ResizeDir, Converter={StaticResource ComparisonXConverter}, ConverterParameter={x:Static local:Dir8.Right}}" Margin="4" Grid.Row="6" Grid.Column="3"/>
            <Button Command="{Binding btnDownLeft_Click}" Content="{Binding Path=ResizeDir, Converter={StaticResource ComparisonXConverter}, ConverterParameter={x:Static local:Dir8.DownLeft}}" Margin="4" Grid.Row="7"/>
            <Button Command="{Binding btnDown_Click}" Content="{Binding Path=ResizeDir, Converter={StaticResource ComparisonXConverter}, ConverterParameter={x:Static local:Dir8.Down}}" Margin="4" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"/>
            <Button Command="{Binding btnDownRight_Click}" Content="{Binding Path=ResizeDir, Converter={StaticResource ComparisonXConverter}, ConverterParameter={x:Static local:Dir8.DownRight}}" Margin="4" Grid.Row="7" Grid.Column="3"/>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*, *">
            <Button Classes="flat" Click="btnCancel_Click" Margin="4" Grid.Column="0">Cancel</Button>
            <Button Classes="flat primary" Click="btnOK_Click" Margin="4" Grid.Column="1">OK</Button>
        </Grid>
    </Grid>

</v:ChromelessWindow>