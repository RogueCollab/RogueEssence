<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RogueEssence.Dev.ViewModels;assembly=RogueEssence.Editor.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="RogueEssence.Dev.Views.SearchListBox"
             DataContextChanged="slb_DataContextChanged">
    <Design.DataContext>
        <vm:SearchListBoxViewModel/>
    </Design.DataContext>
    <Grid Margin="4" RowDefinitions="14, 40, 8, *">
        <TextBlock VerticalAlignment="Bottom" Text="{Binding DataName, Mode=TwoWay}" Grid.Row="0" Grid.Column="0"></TextBlock>
        <TextBox Classes="search" Name="txtSearch" Watermark="Search..." TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding SearchText, Mode=TwoWay}" Margin="0,0" Grid.Row="1" Grid.Column="0"/>
        <ListBox ScrollViewer.HorizontalScrollBarVisibility="Auto" Classes="datalist" Name="lbxItems" SelectionMode="AlwaysSelected" ItemsSource="{Binding SearchItems}" SelectedIndex="{Binding SelectedSearchIndex}" DoubleTapped="doubleClickStart" PointerReleased="lbxItems_DoubleClick" Grid.Row="3" Grid.Column="0"/>
    </Grid>
</UserControl>