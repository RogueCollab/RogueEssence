<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RogueEssence.Dev.ViewModels;assembly=RogueEssence.Editor.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:converters="clr-namespace:RogueEssence.Dev.Converters"
             x:Class="RogueEssence.Dev.Views.GroundTabScript">
  <Design.DataContext>
    <vm:GroundTabScriptViewModel/>
  </Design.DataContext>
  <UserControl.Resources>
    <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
    <converters:MapScriptPathConverter x:Key="MapScriptPathConverter"/>
  </UserControl.Resources>
  <Grid Margin="4" RowDefinitions="20,34,20,*" ColumnDefinitions="130,130,*">
    <TextBlock Margin="4" VerticalAlignment="Bottom" Grid.ColumnSpan="3" Text="{Binding Path=CurrentFile, Converter={StaticResource MapScriptPathConverter}}"/>
    <Button Classes="flat" Width="130" HorizontalContentAlignment="Center" Name="btnOpenScriptDir" Command="{Binding btnOpenScriptDir_Click}" IsEnabled="{Binding Path=CurrentFile, Converter={StaticResource StringNotEmptyConverter}}" Margin="4" Grid.Row="1">Open Script Folder</Button>
    <Button  Classes="flat" Width="130"  HorizontalContentAlignment="Center" Name="btnReloadScripts" Command="{Binding btnReloadScripts_Click}" IsEnabled="{Binding Path=CurrentFile, Converter={StaticResource StringNotEmptyConverter}}" Margin="4" Grid.Row="1" Grid.Column="1">Reload Scripts</Button>
    <TextBlock Margin="4" VerticalAlignment="Bottom" Grid.Row="2">Map Callbacks</TextBlock>
    <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="4" BorderThickness="1" BorderBrush="{DynamicResource Brush.SubStackBorder}">
      <ItemsControl ItemsSource="{Binding ScriptItems}" IsEnabled="{Binding Path=CurrentFile, Converter={StaticResource StringNotEmptyConverter}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="28,*">
              <CheckBox Margin="4" IsEnabled="False" IsChecked="{Binding IsChecked}"/>
              <TextBlock Margin="0,4" Grid.Column="1" VerticalAlignment="Center" Text="{Binding EventType}" ToolTip.Tip="{Binding Definition}">
                <TextBlock.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy Function" Command="{Binding mnuCopyFun_Click}"/>
                  </ContextMenu>
                </TextBlock.ContextMenu>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </Grid>
</UserControl>
