<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RogueEssence.Dev.ViewModels;assembly=RogueEssence.Editor.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:converters="clr-namespace:RogueEssence.Dev.Converters"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             x:Class="RogueEssence.Dev.Views.SpawnListBox">
    <Design.DataContext>
        <vm:SpawnListBoxViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:ValidIdxConverter x:Key="ValidIdxConverter" />
        <converters:PercentConverter x:Key="PercentConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="*, 42" ColumnDefinitions="*, 30">

        <DataGrid Name="gridItems"
                  x:Name="SpawnListBoxDataGrid"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Collection}"
                  SelectedIndex="{Binding CurrentElement, Mode=TwoWay}"
                  CellEditEnded="SpawnListBoxDataGrid_OnCellEditEnded"
                  CellPointerPressed="SpawnListBoxDataGrid_OnCellPointerPressed"
                  Margin="4"
                  Grid.Row="0"
                  Grid.Column="0"
                  MinHeight="50"
                  Classes="default">
            <DataGrid.Columns>
                <DataGridTextColumn IsReadOnly="False" Header="Weight" Binding="{Binding Weight}" Width="70" />
                <DataGridTextColumn IsReadOnly="True" Header="Chance"
                                    Binding="{Binding Path=Chance, Converter={StaticResource PercentConverter}, Mode=OneWay}"
                                    Width="80" />
                <DataGridTextColumn IsReadOnly="True" Header="Value" Binding="{Binding Path=DisplayValue}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="10, 0, 0, 0" VerticalAlignment="Top"
                    Spacing="30">
            <StackPanel Spacing="0">
                <Button x:Name="SpawnListBoxAddButton"
                        PointerReleased="SpawnListBoxAddButton_OnPointerReleased"
                        Classes="secondary" Margin="0, 0" Padding="4, 3">
                    <Path Width="10" Height="10" Margin="0, 2, 0, 0" Data="{StaticResource Icons.Plus}" />
                </Button>
                <Button Command="{Binding btnDelete_Click}"
                        IsEnabled="{Binding HasSelection}"
                        Classes="secondary" Margin="0, 0" Padding="4, 3">
                    <Path Width="10" Height="10" Margin="0, 0, 0, 0" Data="{StaticResource Icons.Minus}" />
                </Button>
            </StackPanel>
            <StackPanel Spacing="0">
                <Button Command="{Binding btnUp_Click}"
                        IsEnabled="{Binding CanMoveUp}"
                        Classes="secondary" Margin="0, 0" Padding="4, 3">
                    <Path Width="10" Height="10" Margin="0, 2, 0, 0" Data="{StaticResource Icons.CaretUpFill}" />
                </Button>
                <Button Command="{Binding btnDown_Click}"
                        IsEnabled="{Binding CanMoveDown}"
                        Classes="secondary" Margin="0, 0" Padding="4, 3">
                    <Path Width="10" Height="10" Margin="0, 0, 0, 0" Data="{StaticResource Icons.CaretDownFill}" />
                </Button>
            </StackPanel>
        </StackPanel>
        
    </Grid>

</UserControl>