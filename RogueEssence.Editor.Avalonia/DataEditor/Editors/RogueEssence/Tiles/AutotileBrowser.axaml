<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RogueEssence.Dev.ViewModels;assembly=RogueEssence.Editor.Avalonia"
             xmlns:views="clr-namespace:RogueEssence.Dev.Views"             
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:RogueEssence.Dev"
             xmlns:data="clr-namespace:RogueEssence.Data;assembly=RogueEssence"
             xmlns:converters="clr-namespace:RogueEssence.Dev.Converters"
             mc:Ignorable="d"
             x:Class="RogueEssence.Dev.Views.AutotileBrowser">
  <Design.DataContext>
    <vm:AutotileBrowserViewModel/>
  </Design.DataContext>
  <UserControl.Resources>
    <converters:TileConverter x:Key="TileConverter"/>
    <converters:DataEntryConverter x:Key="DataEntryConverter"/>
  </UserControl.Resources>
  <Grid Margin="4" RowDefinitions="48,*" ColumnDefinitions="*,*,*">
    <Image Source="{Binding Preview, Converter={StaticResource TileConverter}}" VerticalAlignment="Top" HorizontalAlignment="Left" Stretch="None"/>
    <Image Source="{Binding AssociatePreview, Converter={StaticResource TileConverter}}" VerticalAlignment="Top" HorizontalAlignment="Left" Stretch="None" Grid.Column="1"/>
    <views:SearchListBox DataContext="{Binding Autotiles}" Margin="4, 4, 4, 0" Grid.Row="1" ToolTip.Tip="Choose the autotile.&#x0a;Its texture will be automatically calculated when placed on the map."/>
    <views:SearchListBox DataContext="{Binding AssociateAutotiles}" Margin="4, 4, 4, 0" Grid.Row="1" Grid.Column="1" ToolTip.Tip="Autotiles in the associate list will treat this tile as one of their own in texture calculation.&#x0a;The autotile chosen here will have no effect unless added to the list using the Add button."/>
    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="*,36" ColumnDefinitions="*,30">
      <ListBox Classes="borderless" SelectionMode="AlwaysSelected" ItemsSource="{Binding Associates}" SelectedIndex="{Binding ChosenAssociate}" Margin="4,2" Grid.RowSpan="2" ToolTip.Tip="The actual list of associate tiles.">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={StaticResource DataEntryConverter}, ConverterParameter=1024}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.RowSpan="2" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Top">
        <Button Command="{Binding btnAddTile_Click}" Classes="secondary" Margin="0" Padding="4,3" ToolTip.Tip="Add to the associate list.">
          <Path Width="10" Height="10" Margin="0,2,0,0" Data="{StaticResource Icons.Plus}"/>
        </Button>
        <Button Command="{Binding btnDeleteTile_Click}" Classes="secondary" Margin="0" Padding="4,3" ToolTip.Tip="Delete from the associate list.">
          <Path Width="10" Height="10" Data="{StaticResource Icons.Minus}"/>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
